// Type-checks the Node-run automation in scripts/ and, transitively, the
// src/lib modules it imports. svelte-check only covers src/, so without this
// a change to shared library code can break the coordinator with nothing
// failing until the workflow runs on GitHub.
{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": ["es2022", "dom"],
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["scripts/**/*.ts"]
}
