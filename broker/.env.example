# Broker environment — copy to .env and fill in. Do NOT commit the real .env
# (it's gitignored). These are the broker's own vars, separate from the SPA's
# PUBLIC_ config; the client secret lives ONLY here, never in the SPA build.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the session cookie. Generate one:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=

# The OAuth callback as the browser reaches it (must match the OAuth app's
# registered callback URL). Local dev, via the Vite proxy:
REDIRECT_URL=http://localhost:5173/auth/authorize
# Production:  REDIRECT_URL=https://your-domain.example/auth/authorize

# Local dev only: allows the session cookie over plain HTTP. Remove in production.
FLASK_ENV=development

# Optional: where session files live (default: broker/instance/sessions).
# SESSION_DIR=

# Optional: where the campaign name registry's SQLite database lives
# (default: broker/instance/slugs.db). The registry's entire state is this one
# file — back it up by copying it.
# DB_PATH=

# Bearer token for the registry's /registry/admin/ routes (list slugs, tombstone
# a name). A dev/local fallback and defence in depth — in production the reverse
# proxy must enforce institutional auth for /registry/admin/ (see
# deploy/apache.conf). The routes serve only when ADMIN_TOKEN and
# ADMIN_ROUTES_ENABLED=1 are BOTH set; otherwise they answer 503 (fail closed),
# so a token set for CLI use alone exposes nothing.
# ADMIN_TOKEN=
# ADMIN_ROUTES_ENABLED=1

# Number of reverse proxies in front of the broker (1 behind the deploy/ Apache
# vhosts). When set, X-Forwarded-For supplies the client address the rate
# limits key on. Leave unset when no trusted proxy is in front — the header
# would then be client-supplied and spoofable.
# PROXY_FIX_X_FOR=1

# flask-limiter counter storage. The default memory:// keeps counters per
# worker process, so the effective limits scale with the gunicorn worker count
# and reset on restart. Point at redis/memcached to share counters.
# RATELIMIT_STORAGE_URI=memory://
