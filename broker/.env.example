# Broker environment — copy to .env and fill in. Do NOT commit the real .env
# (it's gitignored). These are the broker's own vars, separate from the SPA's
# PUBLIC_ config; the client secret lives ONLY here, never in the SPA build.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The SPA's origin (exact origin in production; * for local testing only).
ALLOWED_ORIGIN=http://localhost:5173
