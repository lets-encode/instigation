# Broker environment — copy to .env and fill in. Do NOT commit the real .env
# (it's gitignored). These are the broker's own vars, separate from the SPA's
# PUBLIC_ config; the client secret lives ONLY here, never in the SPA build.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the session cookie. Generate one:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=

# The OAuth callback as the browser reaches it (must match the OAuth app's
# registered callback URL). Local dev, via the Vite proxy:
REDIRECT_URL=http://localhost:5173/oauth/authorize
# Production:  REDIRECT_URL=https://your-domain.example/oauth/authorize

# Local dev only: allows the session cookie over plain HTTP. Remove in production.
FLASK_ENV=development

# Optional: where session files live (default: broker/instance/sessions).
# SESSION_DIR=
